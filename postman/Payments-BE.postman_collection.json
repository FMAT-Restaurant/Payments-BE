                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04. Consultas, Tickets e Historial",
      "item": [
        {
          "name": "1. Historial de Ventas Paginado (GET /payments)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments?start_date=2026-11-01T00:00:00Z&end_date=2026-11-30T23:59:59Z&page_index=1&page_size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments"],
              "query": [
                { "key": "start_date", "value": "2026-11-01T00:00:00Z" },
                { "key": "end_date", "value": "2026-11-30T23:59:59Z" },
                { "key": "page_index", "value": "1" },
                { "key": "page_size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Historial de ventas obtenido (200 OK)\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.page_index).to.eql(1);",
                  "    pm.expect(json.page_size).to.eql(10);",
                  "    pm.expect(json.total_count).to.be.a('number');",
                  "    pm.expect(json.data).to.be.an('array');",
                  "    if (json.data.length > 0) {",
                  "        pm.collectionVariables.set(\"folio\", json.data[0].folio);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Detalle de Transacción por Folio (GET /payments/:folio)",
          "request": {
            "method": "GET",
