              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/{{folio}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "{{folio}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Detalle de ticket obtenido (200 OK)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.folio).to.eql(pm.collectionVariables.get(\"folio\"));",
                  "        pm.expect(json.status).to.be.oneOf([\"COMPLETADO\", \"CANCELADO\"]);",
                  "        pm.expect(json.items).to.be.an('array');",
