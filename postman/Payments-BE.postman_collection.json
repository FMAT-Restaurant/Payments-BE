    {
      "name": "01. Turnos de Caja (Cajero)",
      "item": [
        {
          "name": "1. Abrir Turno (POST /cash-shifts/open)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"opening_float\": 500.00\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/cash-shifts/open",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "cash-shifts", "open"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Turno abierto exitosamente (201 Created)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.cash_shift_id).to.be.a('string');",
                  "        pm.expect(json.status).to.eql(\"Open\");",
                  "        pm.expect(json.opening_float).to.eql(500.00);",
                  "        pm.collectionVariables.set(\"cashShiftId\", json.cash_shift_id);",
                  "        console.log(\"Turno guardado en variable:\", json.cash_shift_id);",
                  "    });",
                  "} else if (pm.response.code === 409) {",
                  "    pm.test(\"Cajero ya cuenta con un turno abierto (409 Conflict)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.code).to.eql(\"CASH_SHIFT_ALREADY_OPEN\");",
                  "    });",
                  "} else {",
                  "    pm.test(\"Respuesta inesperada: \" + pm.response.code, function () {",
                  "        pm.expect(pm.response.code).to.be.oneOf([201, 409]);",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Consultar Mi Turno Activo (GET /cash-shifts/me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/cash-shifts/me",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "cash-shifts", "me"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Turno activo encontrado (200 OK)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.cash_shift_id).to.be.a('string');",
                  "        pm.expect(json.status).to.eql(\"Open\");",
                  "        pm.collectionVariables.set(\"cashShiftId\", json.cash_shift_id);",
                  "    });",
                  "} else if (pm.response.code === 404) {",
                  "    pm.test(\"No hay turno activo para este cajero (404 Not Found)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.code).to.eql(\"CASH_SHIFT_NOT_OPEN\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Arqueo en Tiempo Real (GET /cash-shifts/summary)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/cash-shifts/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "cash-shifts", "summary"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Resumen en tiempo real obtenido (200 OK)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.cash_shift_id).to.be.a('string');",
                  "        pm.expect(json.expected_cash).to.be.a('number');",
                  "        pm.expect(json.card_total).to.be.a('number');",
                  "        pm.expect(json.card_transaction_count).to.be.a('number');",
                  "        pm.expect(json.retained_tips).to.be.a('number');",
                  "    });",
                  "} else if (pm.response.code === 404) {",
                  "    pm.test(\"Sin turno abierto para arqueo (404)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"CASH_SHIFT_NOT_OPEN\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Cerrar Turno (POST /cash-shifts/close)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"declared_cash\": 500.00,\n  \"reason\": \"Cierre regular al finalizar jornada\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/cash-shifts/close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "cash-shifts", "close"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Turno cerrado exitosamente (200 OK)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.cash_shift_id).to.be.a('string');",
                  "        pm.expect(json.status).to.be.oneOf([\"Closed\", \"Unbalanced\"]);",
                  "        pm.expect(json.difference).to.be.a('number');",
                  "        pm.expect(json.message).to.be.a('string');",
                  "    });",
                  "} else if (pm.response.code === 422) {",
                  "    pm.test(\"Error de negocio: no hay turno abierto (422 Unprocessable)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"CASH_SHIFT_NOT_OPEN\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Supervisión de Turnos (Admin / Gerente)",
      "item": [
        {
          "name": "1. Listar Turnos Abiertos (GET /cash-shifts/open)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supervisorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/cash-shifts/open",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "cash-shifts", "open"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Lista de turnos abierta obtenida (200 OK)\", function () {",
                  "        const list = pm.response.json();",
                  "        pm.expect(list).to.be.an('array');",
                  "        if (list.length > 0) {",
                  "            pm.collectionVariables.set(\"cashShiftId\", list[0].cash_shift_id);",
                  "        }",
                  "    });",
                  "} else if (pm.response.code === 403) {",
                  "    pm.test(\"Rol no autorizado para supervisión (403 FORBIDDEN_ROLE)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"FORBIDDEN_ROLE\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Arqueo por ID de Turno (GET /cash-shifts/:id/summary)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{supervisorToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/cash-shifts/{{cashShiftId}}/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "cash-shifts", "{{cashShiftId}}", "summary"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Arqueo supervisado obtenido (200 OK)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.cash_shift_id).to.eql(pm.collectionVariables.get(\"cashShiftId\"));",
                  "    });",
                  "} else if (pm.response.code === 404) {",
                  "    pm.test(\"Turno no existe (404 CASH_SHIFT_NOT_FOUND)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"CASH_SHIFT_NOT_FOUND\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Cierre Forzado de Turno (POST /cash-shifts/:id/force-close)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{supervisorToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"declared_cash\": 500.00,\n  \"reason\": \"Cierre forzado: abandono de puesto por el cajero.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/cash-shifts/{{cashShiftId}}/force-close",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "cash-shifts", "{{cashShiftId}}", "force-close"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"Turno cerrado forzosamente (200 OK)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.status).to.be.oneOf([\"Closed\", \"Unbalanced\"]);",
                  "        pm.expect(json.difference).to.be.a('number');",
                  "    });",
                  "} else if (pm.response.code === 409) {",
                  "    pm.test(\"Turno ya estaba cerrado (409 Conflict)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"CASH_SHIFT_ALREADY_CLOSED\");",
                  "    });",
                  "} else if (pm.response.code === 403) {",
                  "    pm.test(\"Rol no supervisor rechazado (403)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"FORBIDDEN_ROLE\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03. Procesamiento de Cobros (Charges)",
      "item": [
        {
          "name": "1. Cobro Exitoso con Efectivo y Cambio (POST /charge)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dinning_session_id\": \"{{dinningSessionId}}\",\n  \"tip\": 15.00,\n  \"payments\": [\n    {\n      \"method\": \"EFECTIVO\",\n      \"amount\": 300.00,\n      \"authorization_reference\": null\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "charge"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.test(\"Cobro completado (201 Created)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.folio).to.be.a('string');",
                  "        pm.expect(json.estado).to.eql(\"COMPLETADO\");",
                  "        pm.expect(json.change_given).to.be.a('number');",
                  "        pm.collectionVariables.set(\"folio\", json.folio);",
                  "        console.log(\"Folio generado:\", json.folio);",
                  "    });",
                  "} else if (pm.response.code === 404) {",
                  "    pm.test(\"Cuenta no encontrada en Redis (404 BILL_NOT_FOUND)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"BILL_NOT_FOUND\");",
                  "    });",
                  "} else if (pm.response.code === 403) {",
                  "    pm.test(\"Caja cerrada: debe abrir caja antes de cobrar (403)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"CASH_SHIFT_NOT_OPEN\");",
                  "    });",
                  "} else if (pm.response.code === 409) {",
                  "    pm.test(\"Sesión ya pagada previamente (409 Conflict)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"TRANSACTION_ALREADY_PAID\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Cobro Mixto (Tarjeta + Efectivo)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
