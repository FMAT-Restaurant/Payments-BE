                  "    pm.expect(pm.response.code).to.be.oneOf([201, 403, 404, 409, 422]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3. Error: Tarjeta sin Referencia de Autorización (422)",
          "request": {
            "method": "POST",
