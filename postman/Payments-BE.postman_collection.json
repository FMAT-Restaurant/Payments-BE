              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "export"],
              "query": [
                { "key": "inicio", "value": "2026-11-01T00:00:00Z" },
                { "key": "fin", "value": "2026-11-10T00:00:00Z" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    pm.test(\"CSV descargado correctamente (200 OK)\", function () {",
                  "        pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/csv\");",
                  "        pm.expect(pm.response.text()).to.include(\"Folio,Fecha,Total\");",
