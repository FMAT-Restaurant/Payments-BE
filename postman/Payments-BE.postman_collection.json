                  "    });",
                  "} else if (pm.response.code === 404) {",
                  "    pm.test(\"Folio no existe (404 TRANSACTION_NOT_FOUND)\", function () {",
                  "        pm.expect(pm.response.json().code).to.eql(\"TRANSACTION_NOT_FOUND\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
