              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dinning_session_id\": \"{{dinningSessionId}}\",\n  \"tip\": 0,\n  \"payments\": [\n    {\n      \"method\": \"TARJETA_DEBITO\",\n      \"amount\": 100.00,\n      \"authorization_reference\": null\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "charge"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 422) {",
                  "    pm.test(\"Rechazado: autorización requerida (422)\", function () {",
                  "        const json = pm.response.json();",
                  "        pm.expect(json.code).to.eql(\"AUTHORIZATION_REFERENCE_REQUIRED\");",
                  "        pm.expect(json.message).to.include(\"referencia de autorización es obligatoria\");",
                  "    });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Error: Fondos Insuficientes con Deficit (422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"dinning_session_id\": \"{{dinningSessionId}}\",\n  \"tip\": 0,\n  \"payments\": [\n    {\n      \"method\": \"EFECTIVO\",\n      \"amount\": 1.00,\n      \"authorization_reference\": null\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/payments/charge",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "payments", "charge"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 422) {",
                  "    pm.test(\"Rechazado: monto no cubre el total (422 INSUFFICIENT_FUNDS)\", function () {",
                  "        const json = pm.response.json();",
                  "        if (json.code === \"INSUFFICIENT_FUNDS\") {",
                  "            pm.expect(json.deficit).to.be.above(0);",
                  "        }",
